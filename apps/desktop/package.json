{
  "name": "@depthwizard/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "DepthWizard desktop: single-image satellite height estimation and 3D flythrough",
  "author": "Yatharth",
  "license": "MIT",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "pnpm build && electron .",
    "dev": "pnpm build && cross-env DW_DEV_URL=http://127.0.0.1:5174 electron .",
    "dist": "pnpm build && electron-builder",
    "dist:mac": "pnpm build && electron-builder --mac",
    "dist:win": "pnpm build && electron-builder --win",
    "dist:linux": "pnpm build && electron-builder --linux"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "cross-env": "^10.0.0",
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2"
  }
}
